{
    "name": "thebigcrafter/oh-my-pmmp",
    "description": "A plugin manager for PocketMine-MP downloads plugin from PocketMine-MP official plugin repository",
    "type": "project",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        }
    ],
    "require": {
        "php": "^8.2",
        "sof3/await-generator": "^3.6",
        "thebigcrafter/commando": "3.3.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.40",
        "phpstan/phpstan": "^2.1",
        "axolotl-pm/pocketmine-mp": "5.50.0"
    },
    "license": "GPL-3.0-only",
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "autoload": {
        "psr-4": {
            "thebigcrafter\\omp\\": "src/thebigcrafter/omp"
        }
    },
    "authors": [
        {
            "name": "thebigcrafter"
        }
    ],
    "scripts": {
        "analyse": "./vendor/bin/phpstan analyse -c phpstan.neon.dist",
        "fix-cs": "./vendor/bin/php-cs-fixer fix"
    }
}
